<Window x:Class="FluenTTY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FluenTTY.Views"
        Title="FluenTTY"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="True" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================= Title bar: sidebar toggle, icon, tabs, actions, caption buttons =======================
             Everything in it is TabHeader.BarHeight (32) tall and vertically centred, so the tab headers (and their
             close buttons), the new-tab / connect buttons and About / Settings all share one centre line. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Panel.ZIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                <Button x:Name="SidebarToggle" Style="{StaticResource TitleBarButton}" Content="&#xE700;"
                        ToolTip="Show or hide saved sessions (Ctrl+Shift+B)" AutomationProperties.Name="Saved sessions"
                        Click="SidebarToggle_Click" />
                <Image Source="/Assets/FluenTTY.png" Width="18" Height="18" Margin="8,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>

            <!-- Tab strip: sliding selection plate behind the headers, then the new-tab buttons -->
            <Grid Grid.Column="1" x:Name="TabArea" ClipToBounds="False" Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- Scrolls sideways (mouse wheel, selecting a tab) only when even the narrowest tabs don't fit -->
                <ScrollViewer x:Name="TabScroller" VerticalAlignment="Center" Focusable="False" CanContentScroll="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="TabLayer" Height="32">
                    <Border x:Name="SelectionPlate" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Width="100" CornerRadius="6" BorderThickness="1" Opacity="0"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PlateOffset" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button x:Name="NewTabButton" Style="{StaticResource TitleBarButton}" Content="&#xE710;"
                            ToolTip="New tab (Ctrl+Shift+T)" AutomationProperties.Name="New tab" Click="NewTab_Click" />
                    <Button x:Name="ConnectButton" Style="{StaticResource TitleBarButton}" Content="&#xE721;"
                            ToolTip="Connect to a session or address (Ctrl+Shift+P)" AutomationProperties.Name="Connect" Click="Connect_Click" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE946;"
                        ToolTip="About, licenses and disclosures" AutomationProperties.Name="About" Click="About_Click" />
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE713;"
                        ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings" Click="Settings_Click" />
            </StackPanel>

            <!-- Space for the Windows caption buttons (drawn by DWM: genuine hover, snap layouts, dark mode) -->
            <Border Grid.Column="3" x:Name="CaptionSpacer" Width="138" IsHitTestVisible="False" />
        </Grid>

        <!-- Solid background under the content when there's no Mica. The title row never gets one: DWM draws
             the min/max/close buttons *beneath* the client area, so it must stay see-through (IDwmCaptionWindow). -->
        <Border Grid.Row="1" x:Name="BodyBackground" />

        <!-- ======================= Content: sidebar card + tab host card =======================
             Two rounded cards floating on the window material, with a gap under the tab strip and between them.
             MainWindow.ApplySidebar sets the margins (none in full screen). -->
        <Grid Grid.Row="1" x:Name="Body" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Update bar (Views\UpdateUi.cs), collapsed unless a new version is out -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="UpdateBarHost" Grid.ColumnSpan="3" Focusable="False" />

            <Border x:Name="SidebarCard" Grid.Row="1" Grid.Column="0" Margin="8,0,0,8" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <views:SessionsSidebar x:Name="Sidebar" Margin="2,6,2,4" />
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Row="1" Grid.Column="1" Width="6" Background="Transparent" HorizontalAlignment="Stretch"
                          DragCompleted="SidebarSplitter_DragCompleted" />

            <Border x:Name="ContentCard" Grid.Row="1" Grid.Column="2" Margin="0,0,8,8" CornerRadius="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <!-- Clipped to the card's rounded inner edge in code (UpdateContentClip) -->
                <Grid x:Name="TabHost" ClipToBounds="True" />
            </Border>

            <!-- Connection palette (Ctrl+Shift+P) sits over everything -->
            <views:ConnectPalette x:Name="Palette" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" Panel.ZIndex="10" />
        </Grid>
    </Grid>
</Window>
