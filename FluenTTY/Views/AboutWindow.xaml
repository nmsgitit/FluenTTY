<Window x:Class="FluenTTY.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FluenTTY" Width="820" Height="620" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Icon="/Assets/FluenTTY.ico"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Section nav with one shared selection pill that slides between items -->
        <Grid>
            <ListBox x:Name="Nav" Style="{StaticResource RowList}" Padding="0"
                     SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="About sections">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="36">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Text="{Binding Glyph}" VerticalAlignment="Center" Margin="4,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Rectangle x:Name="NavIndicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                       HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                       Fill="{DynamicResource AccentFillColorDefaultBrush}">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="NavIndicatorOffset" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="8" Padding="24,20"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid ClipToBounds="True">
                <!-- About -->
                <ScrollViewer x:Name="AboutPane" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/FluenTTY.png" Width="64" Height="64" VerticalAlignment="Top" />
                            <StackPanel Margin="18,2,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="26" FontWeight="SemiBold" Text="FluenTTY" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="-4,4,0,0">
                                    <Button Style="{StaticResource LinkButton}" Content="What's new" Click="WhatsNew_Click" />
                                    <Button Style="{StaticResource LinkButton}" Content="Check for updates" Margin="8,0,0,0" Click="CheckUpdates_Click" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,22,0,0"
                                   Text="A tabbed remote management client for Windows built on Microsoft's Fluent 2 design language: SSH, SFTP, Telnet, Rlogin, Rsh, raw TCP and serial consoles with a VT/xterm terminal, FTP/FTPS file browsing with an embedded editor, and Remote Desktop, VNC and XDMCP sessions." />
                        <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Its terminal, keyboard and connection options follow PuTTY 0.85, and it imports PuTTY and PuTTY Connection Manager sessions." />
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="16" Text="Privacy" Margin="0,22,0,6" />
                        <TextBlock x:Name="PrivacyText" Style="{StaticResource Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="16" Text="This copy" Margin="0,22,0,6" />
                        <TextBlock x:Name="InstallText" Style="{StaticResource Body}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="OpenDataButton" Style="{StaticResource LinkButton}" Content="Open the data folder" HorizontalAlignment="Left" Margin="-4,6,0,0" Click="OpenData_Click" />
                        <TextBlock x:Name="CopyrightText" Style="{StaticResource Caption}" Margin="0,22,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Text="Licensed under the MIT License. Third-party components are listed under Licenses." Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Licenses -->
                <Grid x:Name="LicensesPane" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Licenses" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="FluenTTY is released under the MIT License. It is built on the open-source components below, each used under its own license. A copy of these notices is installed alongside the app as THIRD-PARTY-NOTICES.md." />
                    <ComboBox x:Name="ComponentBox" Grid.Row="2" HorizontalAlignment="Stretch" SelectionChanged="Component_SelectionChanged"
                              AutomationProperties.Name="Component">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ComponentNote" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ComponentUrl" Style="{StaticResource Caption}" Margin="0,4,0,0" Cursor="Hand"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" MouseLeftButtonUp="ComponentUrl_Click" />
                        </StackPanel>
                        <TextBox x:Name="LicenseText" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="10" AutomationProperties.Name="License text" />
                    </Grid>
                </Grid>

                <!-- AI disclosure -->
                <ScrollViewer x:Name="AiPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock x:Name="AiTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AiText" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
